# Restricted GitHub Actions workflow_dispatch credentials for Tokyo EC2 QA notifier.
# Deploy ONLY to `/etc/tokyo-l2/github_qa_dispatch.env` with strict local permissions:
#   sudo install -m 0600 -o ubuntu -g ubuntu collector/deploy/env/github_qa_dispatch.env.example /etc/tokyo-l2/github_qa_dispatch.env
#   sudo nano /etc/tokyo-l2/github_qa_dispatch.env
#
# SECURITY RULES:
# - NEVER commit real tokens to git.
# - Create a fine-grained Personal Access Token scoped ONLY to repository `Huhabubu/mm`
#   with ONLY `Actions: Read and write` (no Contents, no Secrets, no Admin).
# - Loaded ONLY by `tokyo-l2-qa-dispatch.service`
#   (NEVER loaded by `tokyo-l2-collector.service`, `tokyo-l2-archive.service`, or `tokyo-l2-meta.service`).

TOKYO_L2_GITHUB_QA_DISPATCH_TOKEN=REPLACE_WITH_FINE_GRAINED_PAT
TOKYO_L2_GITHUB_REPO=Huhabubu/mm
TOKYO_L2_GITHUB_QA_WORKFLOW=tokyo-l2-incremental-qa.yml
TOKYO_L2_GITHUB_QA_REF=main
# Reconcile ACCEPTED dispatches against persisted QA reports on `tokyo-l2-qa-state`.
# Stale ACCEPTED entries without a matching final report (e.g. replaced in concurrency queue)
# are requeued to PENDING after TOKYO_L2_GITHUB_QA_ACCEPTED_STALE_TIMEOUT_S seconds.
# Reconciliation is fail-closed: unless pinned explicitly below, the notifier automatically
# resolves the current checker commit from TOKYO_L2_GITHUB_QA_SOURCE_REF and protocol rules_sha
# from TOKYO_L2_GITHUB_QA_REF before accepting any QA report.
TOKYO_L2_GITHUB_QA_STATE_BRANCH=tokyo-l2-qa-state
TOKYO_L2_GITHUB_QA_SOURCE_REF=feat/tokyo-l2-reliability-fixes
TOKYO_L2_GITHUB_QA_ACCEPTED_STALE_TIMEOUT_S=1800
# Require BOTH window + protocol QA reports matching current checker commit and protocol rules_sha.
TOKYO_L2_GITHUB_QA_REQUIRE_PROTOCOL_REPORT=1
# Optional explicit pins overriding live GitHub resolution:
# TOKYO_L2_GITHUB_QA_EXPECTED_CHECKER_COMMIT=
# TOKYO_L2_GITHUB_QA_EXPECTED_PROTOCOL_CHECKER=
