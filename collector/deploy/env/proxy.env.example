# P5 Lightsail SOCKS5 Archive Proxy Configuration for Tokyo EC2.
# Deploy ONLY to `/etc/tokyo-l2/proxy.env` with strict permissions:
#   sudo install -m 0600 -o ubuntu -g ubuntu collector/deploy/env/proxy.env.example /etc/tokyo-l2/proxy.env
#   sudo nano /etc/tokyo-l2/proxy.env
#
# ISOLATION RULES:
# - NEVER place global HTTP_PROXY / HTTPS_PROXY / ALL_PROXY variables in this file or /etc/environment!
# - Loaded ONLY by `tokyo-l2-lightsail-proxy.service` and `tokyo-l2-archive.service.d/lightsail-proxy.conf`
#   (and optionally `tokyo-l2-meta.service` if tunnel alert monitoring is desired).
# - NEVER loaded by `tokyo-l2-collector.service` (Rust 4-exchange WebSockets stay direct on EC2).
# - Primary EC2 -> Lightsail SSH path uses Tokyo AZ 1a VPC Peering private IP (`172.26.12.211:22`, $0/GB in same physical AZ).
# - Public IP (`13.192.29.63`) is kept strictly as backup SSH target + verified `HostKeyAlias` identity.
# - Store the dedicated private key ONLY on EC2 (`/etc/tokyo-l2/tokyo_l2_lightsail`, chmod 0600);
#   never commit private keys into git.

# Primary SSH target via same-AZ (`ap-northeast-1a`) VPC Peering private IP
TOKYO_L2_LIGHTSAIL_HOST=172.26.12.211
# Public IP retained as backup fallback address and verified HostKeyAlias identity
TOKYO_L2_LIGHTSAIL_PUBLIC_FALLBACK_HOST=13.192.29.63
TOKYO_L2_LIGHTSAIL_HOSTKEY_ALIAS=13.192.29.63
TOKYO_L2_LIGHTSAIL_PORT=22
TOKYO_L2_LIGHTSAIL_USER=ubuntu
TOKYO_L2_LIGHTSAIL_KEY=/etc/tokyo-l2/tokyo_l2_lightsail
TOKYO_L2_LIGHTSAIL_KNOWN_HOSTS=/etc/tokyo-l2/lightsail_known_hosts
TOKYO_L2_EC2_AZ=ap-northeast-1a
TOKYO_L2_LIGHTSAIL_AZ=ap-northeast-1a

# Local loopback SOCKS5 bind (127.0.0.1 only; never 0.0.0.0)
TOKYO_L2_PROXY_BIND_ADDR=127.0.0.1
TOKYO_L2_PROXY_BIND_PORT=1080

# Consumed strictly by RcloneBackend child `rclone` subprocesses ONLY (`required` keeps fail-closed semantics).
# Do NOT set `fallback_direct`; keep auto-prune (`--prune-hours 24`) disabled.
TOKYO_L2_ARCHIVE_PROXY_URL=socks5://127.0.0.1:1080
TOKYO_L2_ARCHIVE_PROXY_MODE=required
