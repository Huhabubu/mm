# Restricted P3 Telegram & Healthchecks environment variables for Tokyo EC2.
# Deploy ONLY to `/etc/tokyo-l2/notify.env` with strict local permissions:
#   sudo install -m 0600 -o ubuntu -g ubuntu collector/deploy/env/notify.env.example /etc/tokyo-l2/notify.env
#   sudo nano /etc/tokyo-l2/notify.env
#
# SECURITY RULES:
# - NEVER commit real tokens, chat IDs, or ping URLs to git.
# - Loaded ONLY by `tokyo-l2-meta.service` and `tokyo-l2-archive.service`
#   (NEVER loaded by `tokyo-l2-collector.service` Rust live engine).

# Telegram Bot credentials (from @BotFather & your private/ops chat ID)
TOKYO_L2_TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TOKYO_L2_TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID

# Healthchecks ping URLs (two separate checks recommended:
#   1. Collector liveness check: Period = 5m, Grace = 10m
#   2. Hourly Archive check: Period = 1h, Grace = 20m)
TOKYO_L2_HEALTHCHECKS_COLLECTOR_URL=https://hc-ping.com/REPLACE-COLLECTOR-CHECK-UUID
TOKYO_L2_HEALTHCHECKS_ARCHIVE_URL=https://hc-ping.com/REPLACE-ARCHIVE-CHECK-UUID

# Optional fallback generic webhook (leave commented out if using native Telegram Bot API)
# TOKYO_L2_ALERT_WEBHOOK_URL=https://example.invalid/webhook
