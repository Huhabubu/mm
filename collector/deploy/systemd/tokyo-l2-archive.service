[Unit]
Description=AWS Tokyo L2 Hourly Atomic Archive & Google Drive Remote Verifier
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/mm
EnvironmentFile=-/etc/tokyo-l2/live.env
# Safe default: auto-pruning stays OFF until fault-injection + real Google Drive readback tests pass.
# Only after user signoff, enable `--prune-hours 24` via a systemd drop-in override.
ExecStart=/opt/mm/collector/bin/archive --dir /data/tokyo_l2 --remote gdrive_main:tokyo_l2_data --verify-remote
StandardOutput=journal
StandardError=journal
