# Optional P5 systemd drop-in for `tokyo-l2-archive.service` ONLY.
# Install ONLY after:
#   1. Private VPC Peering tunnel verified on temporary `127.0.0.1:1081` (`proxy-verify verify`)
#   2. `proxy-verify check-takeover --port 1080 --data-root /data/tokyo_l2` passes and
#      `tokyo-l2-lightsail-proxy.service` owns `127.0.0.1:1080` cleanly
#   3. Same-AZ (ap-northeast-1a) VPC Peering cost/quota check passes (`compare-report`; AWS bill is reconciliation-only)
#
# Install path on EC2:
#   sudo mkdir -p /etc/systemd/system/tokyo-l2-archive.service.d
#   sudo install -m 0644 collector/deploy/systemd/tokyo-l2-archive.service.d/lightsail-proxy.conf.example \
#     /etc/systemd/system/tokyo-l2-archive.service.d/lightsail-proxy.conf
#   sudo systemctl daemon-reload
#
# IMPORTANT: Do NOT set global HTTP_PROXY / HTTPS_PROXY here!
# Keep `TOKYO_L2_ARCHIVE_PROXY_MODE=required` (no `fallback_direct`) and do NOT add `--prune-hours 24`.
# Only `TOKYO_L2_ARCHIVE_PROXY_*` is set so `RcloneBackend` injects proxy variables strictly into
# spawned `rclone` subprocesses while Healthchecks/Telegram notifications stay direct.

[Unit]
After=network-online.target tokyo-l2-lightsail-proxy.service
Wants=tokyo-l2-lightsail-proxy.service

[Service]
EnvironmentFile=/etc/tokyo-l2/proxy.env
